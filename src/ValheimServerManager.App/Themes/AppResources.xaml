<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="VsmAmberColor">#F2B04E</Color>
            <Color x:Key="VsmNightColor">#1E3A4A</Color>
            <SolidColorBrush x:Key="VsmAmberBrush" Color="#F2B04E" />
            <SolidColorBrush x:Key="VsmRunningBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="VsmStoppedBrush" Color="#9A9A9A" />
            <SolidColorBrush x:Key="VsmBusyBrush" Color="#F2B04E" />
            <SolidColorBrush x:Key="VsmCrashedBrush" Color="#FF6B6B" />
            <SolidColorBrush x:Key="VsmCreativeBrush" Color="#B38CFF" />
            <SolidColorBrush x:Key="VsmHeroBackgroundBrush" Color="#14FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="VsmAmberColor">#B86E0B</Color>
            <Color x:Key="VsmNightColor">#1E3A4A</Color>
            <SolidColorBrush x:Key="VsmAmberBrush" Color="#B86E0B" />
            <SolidColorBrush x:Key="VsmRunningBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="VsmStoppedBrush" Color="#6E6E6E" />
            <SolidColorBrush x:Key="VsmBusyBrush" Color="#B86E0B" />
            <SolidColorBrush x:Key="VsmCrashedBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="VsmCreativeBrush" Color="#7A4FD6" />
            <SolidColorBrush x:Key="VsmHeroBackgroundBrush" Color="#0A000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="VsmAmberColor">#FFFF00</Color>
            <Color x:Key="VsmNightColor">#000000</Color>
            <SolidColorBrush x:Key="VsmAmberBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="VsmRunningBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="VsmStoppedBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="VsmBusyBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="VsmCrashedBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="VsmCreativeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="VsmHeroBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="PageMaxWidth">1100</x:Double>
    <Thickness x:Key="PagePadding">36,24,36,36</Thickness>
    <x:Double x:Key="SettingsCardSpacing">4</x:Double>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="1,28,0,8" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="StatLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="StatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="MonoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
