<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ValheimServerManager.App.Views.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:ValheimServerManager.App.Helpers"
    xmlns:vm="using:ValheimServerManager.App.ViewModels">

    <Grid Padding="{StaticResource PagePadding}" ColumnSpacing="16" RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2" Style="{StaticResource PageTitleStyle}" Text="Log do servidor" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16">
            <ToggleSwitch IsOn="{x:Bind ViewModel.OnlyImportant, Mode=TwoWay}" OffContent="Todas as linhas" OnContent="Só eventos importantes" />
            <ToggleSwitch IsOn="{x:Bind ViewModel.FollowTail, Mode=TwoWay}" OffContent="Rolagem livre" OnContent="Acompanhar o fim" />
            <Button VerticalAlignment="Center" Command="{x:Bind ViewModel.OpenCurrentLogCommand}" Content="Abrir arquivo" />
            <Button VerticalAlignment="Center" Command="{x:Bind ViewModel.CopyAllCommand}" Content="Copiar" />
        </StackPanel>

        <Border Grid.Row="2" Padding="4" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <TextBlock
                    Margin="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind helpers:Ui.VisibleIfText(ViewModel.EmptyText), Mode=OneWay}" />
                <ListView x:Name="LinesList" ItemsSource="{x:Bind ViewModel.Lines}" SelectionMode="Extended">
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="8,1" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogLineItem">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource MonoTextStyle}" Text="{x:Bind Time}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource MonoTextStyle}" Text="{x:Bind Text}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Spacing="8">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Sessões anteriores" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap">
                O servidor recria o log a cada início; o gerenciador arquiva o anterior aqui.
            </TextBlock>
            <ListView IsItemClickEnabled="True" ItemClick="OnArchivedClick" ItemsSource="{x:Bind ViewModel.ArchivedLogs}" SelectionMode="None" />
        </StackPanel>
    </Grid>
</Page>
