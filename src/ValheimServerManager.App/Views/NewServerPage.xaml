<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ValheimServerManager.App.Views.NewServerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:ValheimServerManager.App.Helpers"
    xmlns:loc="using:ValheimServerManager.App.Localization"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:ValheimServerManager.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind loc:SettingsStrings.NewServer_Title}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{x:Bind loc:SettingsStrings.NewServer_Subtitle}" />

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind loc:SettingsStrings.Settings_SectionIdentity}" />
                <toolkit:SettingsCard Description="{x:Bind loc:SettingsStrings.NewServer_ServerName_Description}" Header="{x:Bind loc:SettingsStrings.Settings_ServerName_Header}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE968;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <TextBox
                        MinWidth="280"
                        AutomationProperties.Name="{x:Bind loc:SettingsStrings.Settings_ServerName_Header}"
                        PlaceholderText="{x:Bind loc:SettingsStrings.NewServer_ServerName_Placeholder}"
                        Text="{x:Bind ViewModel.ServerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="{x:Bind loc:SettingsStrings.NewServer_Password_Description}" Header="{x:Bind loc:SettingsStrings.Settings_Password_Header}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PasswordBox
                            MinWidth="240"
                            AutomationProperties.Name="{x:Bind loc:SettingsStrings.Settings_Password_Header}"
                            PasswordChanged="OnPasswordChanged"
                            PasswordRevealMode="{x:Bind helpers:Ui.RevealMode(ViewModel.ShowPassword), Mode=OneWay}" />
                        <ToggleButton
                            VerticalAlignment="Stretch"
                            AutomationProperties.Name="{x:Bind loc:SettingsStrings.Settings_ShowPassword}"
                            IsChecked="{x:Bind ViewModel.ShowPassword, Mode=TwoWay}"
                            ToolTipService.ToolTip="{x:Bind loc:SettingsStrings.Settings_ShowHidePasswordTooltip}">
                            <FontIcon FontSize="16" Glyph="{x:Bind helpers:Ui.EyeGlyph(ViewModel.ShowPassword), Mode=OneWay}" />
                        </ToggleButton>
                    </StackPanel>
                </toolkit:SettingsCard>

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind loc:SettingsStrings.NewServer_SectionWorld}" />
                <toolkit:SettingsCard Header="{x:Bind loc:SettingsStrings.NewServer_WorldSource_Header}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE909;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <RadioButtons AutomationProperties.Name="{x:Bind loc:SettingsStrings.NewServer_WorldSource_Header}" SelectedIndex="{x:Bind ViewModel.WorldModeIndex, Mode=TwoWay}">
                        <RadioButton Content="{x:Bind loc:SettingsStrings.NewServer_WorldSourceNew}" />
                        <RadioButton Content="{x:Bind loc:SettingsStrings.NewServer_WorldSourceExisting}" />
                    </RadioButtons>
                </toolkit:SettingsCard>

                <StackPanel Spacing="{StaticResource SettingsCardSpacing}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.IsNewWorld), Mode=OneWay}">
                    <toolkit:SettingsCard Description="{x:Bind loc:SettingsStrings.NewServer_WorldName_Description}" Header="{x:Bind loc:SettingsStrings.NewServer_WorldName_Header}">
                        <TextBox
                            MinWidth="240"
                            AutomationProperties.Name="{x:Bind loc:SettingsStrings.NewServer_WorldName_Header}"
                            MaxLength="20"
                            Text="{x:Bind ViewModel.WorldName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Description="{x:Bind loc:SettingsStrings.NewServer_Seed_Description}" Header="{x:Bind loc:SettingsStrings.NewServer_Seed_Header}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBox
                                MinWidth="180"
                                AutomationProperties.Name="{x:Bind loc:SettingsStrings.NewServer_Seed_Header}"
                                FontFamily="Cascadia Mono, Consolas"
                                MaxLength="10"
                                Text="{x:Bind ViewModel.Seed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button AutomationProperties.Name="{x:Bind loc:SettingsStrings.NewServer_NewSeed}" Command="{x:Bind ViewModel.NewSeedCommand}" ToolTipService.ToolTip="{x:Bind loc:SettingsStrings.NewServer_NewSeedTooltip}">
                                <FontIcon FontSize="16" Glyph="&#xE8B1;" />
                            </Button>
                        </StackPanel>
                    </toolkit:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="{StaticResource SettingsCardSpacing}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.IsExistingWorld), Mode=OneWay}">
                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="{x:Bind loc:SettingsStrings.NewServer_ExistingWorldInfo}"
                        Severity="Informational" />
                    <Border Padding="8" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Margin="8,4"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind loc:SettingsStrings.NewServer_NoGameWorlds}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind helpers:Ui.Collapsed(ViewModel.HasGameWorlds), Mode=OneWay}" />
                            <ListView
                                MaxHeight="280"
                                AutomationProperties.Name="{x:Bind loc:SettingsStrings.NewServer_AvailableWorlds}"
                                ItemsSource="{x:Bind ViewModel.GameWorlds}"
                                SelectedItem="{x:Bind ViewModel.SelectedWorld, Mode=TwoWay}"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorldChoice">
                                        <StackPanel Padding="4,6" AutomationProperties.Name="{x:Bind Name}">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Margin="8,0,8,4" AutomationProperties.Name="{x:Bind loc:SettingsStrings.NewServer_ChooseOtherFolder}" Command="{x:Bind ViewModel.BrowseWorldCommand}" Content="{x:Bind loc:SettingsStrings.NewServer_ChooseOtherWorldFolder}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind loc:SettingsStrings.NewServer_SectionRules}" />
                <toolkit:SettingsCard Description="{x:Bind loc:SettingsStrings.NewServer_Preset_Description}" Header="{x:Bind loc:SettingsStrings.NewServer_Preset_Header}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox MinWidth="220" AutomationProperties.Name="{x:Bind loc:SettingsStrings.NewServer_Preset_Header}" ItemsSource="{x:Bind ViewModel.PresetItems}" SelectedIndex="{x:Bind ViewModel.PresetIndex, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:OptionItem">
                                <TextBlock AutomationProperties.Name="{x:Bind Label}" Text="{x:Bind Label}" ToolTipService.ToolTip="{x:Bind Description}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="{x:Bind loc:SettingsStrings.NewServer_Creative_Description}" Header="{x:Bind loc:SettingsStrings.NewServer_Creative_Header}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE70F;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch AutomationProperties.Name="{x:Bind loc:SettingsStrings.NewServer_Creative_Header}" IsOn="{x:Bind ViewModel.CreativeMode, Mode=TwoWay}" />
                </toolkit:SettingsCard>

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind loc:SettingsStrings.NewServer_SectionAccess}" />
                <toolkit:SettingsCard Description="{x:Bind loc:SettingsStrings.NewServer_Port_Description}" Header="{x:Bind loc:SettingsStrings.Settings_Port_Header}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE968;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <NumberBox AutomationProperties.Name="{x:Bind loc:SettingsStrings.Settings_Port_Header}" Maximum="65534" Minimum="1024" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.Port, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="{x:Bind loc:SettingsStrings.NewServer_Public_Description}" Header="{x:Bind loc:SettingsStrings.Settings_Public_Header}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch AutomationProperties.Name="{x:Bind loc:SettingsStrings.Settings_Public_Header}" IsOn="{x:Bind ViewModel.IsPublic, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="{x:Bind loc:SettingsStrings.NewServer_Crossplay_Description}" Header="{x:Bind loc:SettingsStrings.Settings_Crossplay_Header}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch AutomationProperties.Name="{x:Bind loc:SettingsStrings.Settings_Crossplay_Header}" IsOn="{x:Bind ViewModel.Crossplay, Mode=TwoWay}" />
                </toolkit:SettingsCard>

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind loc:SettingsStrings.Settings_SectionFolders}" />
                <toolkit:SettingsExpander Description="{x:Bind loc:SettingsStrings.NewServer_Folders_Description}" Header="{x:Bind loc:SettingsStrings.NewServer_Folders_Header}">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard ContentAlignment="Vertical" Header="{x:Bind loc:SettingsStrings.NewServer_ServerInstall_Header}" HorizontalContentAlignment="Stretch">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox AutomationProperties.Name="{x:Bind loc:SettingsStrings.Settings_ServerInstall_Header}" Text="{x:Bind ViewModel.ServerDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.BrowseServerDirectoryCommand}" Content="{x:Bind loc:SettingsStrings.Settings_Browse}" />
                            </Grid>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard ContentAlignment="Vertical" Header="{x:Bind loc:SettingsStrings.NewServer_SaveFolder_Header}" HorizontalContentAlignment="Stretch">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox AutomationProperties.Name="{x:Bind loc:SettingsStrings.NewServer_SaveFolder_Name}" Text="{x:Bind ViewModel.SaveDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.BrowseSaveDirectoryCommand}" Content="{x:Bind loc:SettingsStrings.Settings_Browse}" />
                            </Grid>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <ItemsControl Margin="0,12,0,0" ItemsSource="{x:Bind ViewModel.Issues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:IssueItem">
                            <InfoBar Margin="0,0,0,4" IsClosable="False" IsOpen="True" Message="{x:Bind Message}" Severity="{x:Bind Severity}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Padding="36,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid MaxWidth="{StaticResource PageMaxWidth}" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                    <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.BusyText, Mode=OneWay}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{x:Bind ViewModel.CancelCommand}" Content="{x:Bind loc:SettingsStrings.NewServer_Cancel}" />
                <Button Grid.Column="2" Command="{x:Bind ViewModel.CreateCommand}" Content="{x:Bind loc:SettingsStrings.NewServer_Create}" IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}" />
                <Button
                    Grid.Column="3"
                    MinWidth="140"
                    Command="{x:Bind ViewModel.CreateAndStartCommand}"
                    Content="{x:Bind loc:SettingsStrings.NewServer_CreateAndStart}"
                    IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Page>
