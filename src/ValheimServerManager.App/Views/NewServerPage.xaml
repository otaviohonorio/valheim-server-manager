<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ValheimServerManager.App.Views.NewServerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:ValheimServerManager.App.Helpers"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:ValheimServerManager.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Novo servidor" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Cria o servidor e o mundo dele numa pasta só dele. Modificadores finos e listas de jogadores podem ser ajustados depois." />

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Identificação" />
                <toolkit:SettingsCard Description="Nome que aparece para os jogadores e aqui no gerenciador." Header="Nome do servidor">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE968;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <TextBox
                        MinWidth="280"
                        AutomationProperties.Name="Nome do servidor"
                        PlaceholderText="Ex.: Vikings da Vila"
                        Text="{x:Bind ViewModel.ServerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Mínimo de 5 caracteres, não pode estar dentro do nome do servidor." Header="Senha">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PasswordBox
                            MinWidth="240"
                            AutomationProperties.Name="Senha"
                            PasswordChanged="OnPasswordChanged"
                            PasswordRevealMode="{x:Bind helpers:Ui.RevealMode(ViewModel.ShowPassword), Mode=OneWay}" />
                        <ToggleButton
                            VerticalAlignment="Stretch"
                            AutomationProperties.Name="Mostrar senha"
                            IsChecked="{x:Bind ViewModel.ShowPassword, Mode=TwoWay}"
                            ToolTipService.ToolTip="Mostrar/ocultar senha">
                            <FontIcon FontSize="16" Glyph="{x:Bind helpers:Ui.EyeGlyph(ViewModel.ShowPassword), Mode=OneWay}" />
                        </ToggleButton>
                    </StackPanel>
                </toolkit:SettingsCard>

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Mundo" />
                <toolkit:SettingsCard Header="De onde vem o mundo">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE909;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <RadioButtons AutomationProperties.Name="De onde vem o mundo" SelectedIndex="{x:Bind ViewModel.WorldModeIndex, Mode=TwoWay}">
                        <x:String>Criar um mundo novo</x:String>
                        <x:String>Usar um mundo que já tenho</x:String>
                    </RadioButtons>
                </toolkit:SettingsCard>

                <StackPanel Spacing="{StaticResource SettingsCardSpacing}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.IsNewWorld), Mode=OneWay}">
                    <toolkit:SettingsCard Description="Nome da pasta do mundo. Letras sem acento, números, espaço, - ou _." Header="Nome do mundo">
                        <TextBox
                            MinWidth="240"
                            AutomationProperties.Name="Nome do mundo"
                            MaxLength="20"
                            Text="{x:Bind ViewModel.WorldName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Description="A mesma seed sempre gera o mesmo mapa. Até 10 letras ou números — use a de um mapa que você goste ou gere uma aleatória." Header="Seed">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBox
                                MinWidth="180"
                                AutomationProperties.Name="Seed"
                                FontFamily="Cascadia Mono, Consolas"
                                MaxLength="10"
                                Text="{x:Bind ViewModel.Seed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button AutomationProperties.Name="Gerar outra seed" Command="{x:Bind ViewModel.NewSeedCommand}" ToolTipService.ToolTip="Gerar outra seed aleatória">
                                <FontIcon FontSize="16" Glyph="&#xE8B1;" />
                            </Button>
                        </StackPanel>
                    </toolkit:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="{StaticResource SettingsCardSpacing}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.IsExistingWorld), Mode=OneWay}">
                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="O mundo original não é alterado: o gerenciador confere e copia o save mais recente para a pasta do servidor. Depois disso, jogue esse mundo pelo servidor."
                        Severity="Informational" />
                    <Border Padding="8" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Margin="8,4"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Nenhum mundo local encontrado no jogo. Use o botão abaixo para escolher uma pasta."
                                TextWrapping="Wrap"
                                Visibility="{x:Bind helpers:Ui.Collapsed(ViewModel.HasGameWorlds), Mode=OneWay}" />
                            <ListView
                                MaxHeight="280"
                                AutomationProperties.Name="Mundos disponíveis"
                                ItemsSource="{x:Bind ViewModel.GameWorlds}"
                                SelectedItem="{x:Bind ViewModel.SelectedWorld, Mode=TwoWay}"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorldChoice">
                                        <StackPanel Padding="4,6" AutomationProperties.Name="{x:Bind Name}">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Margin="8,0,8,4" AutomationProperties.Name="Escolher outra pasta" Command="{x:Bind ViewModel.BrowseWorldCommand}" Content="Escolher outra pasta de mundo…" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Regras" />
                <toolkit:SettingsCard Description="Os modificadores finos ficam na tela Mundo depois de criar." Header="Preset">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox MinWidth="220" AutomationProperties.Name="Preset" ItemsSource="{x:Bind ViewModel.PresetItems}" SelectedIndex="{x:Bind ViewModel.PresetIndex, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:OptionItem">
                                <TextBlock AutomationProperties.Name="{x:Bind Label}" Text="{x:Bind Label}" ToolTipService.ToolTip="{x:Bind Description}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Construção e craft sem custo para todos; conquistas bloqueadas enquanto ligado. Dá para trocar a qualquer momento no Painel." Header="Começar em modo criativo">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE70F;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch AutomationProperties.Name="Começar em modo criativo" IsOn="{x:Bind ViewModel.CreativeMode, Mode=TwoWay}" />
                </toolkit:SettingsCard>

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Acesso" />
                <toolkit:SettingsCard Description="Já vem sugerida uma porta livre. O servidor usa ela e a seguinte." Header="Porta">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE968;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <NumberBox AutomationProperties.Name="Porta" Maximum="65534" Minimum="1024" SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.Port, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Aparecer na lista pública de servidores do jogo." Header="Servidor público">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch AutomationProperties.Name="Servidor público" IsOn="{x:Bind ViewModel.IsPublic, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Código de convite e Xbox/Game Pass, sem redirecionar portas no roteador." Header="Crossplay">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch AutomationProperties.Name="Crossplay" IsOn="{x:Bind ViewModel.Crossplay, Mode=TwoWay}" />
                </toolkit:SettingsCard>

                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Pastas" />
                <toolkit:SettingsExpander Description="Preenchidas automaticamente; mude só se quiser." Header="Onde instalar e salvar">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard ContentAlignment="Vertical" Header="Instalação do Valheim Dedicated Server" HorizontalContentAlignment="Stretch">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox AutomationProperties.Name="Instalação do servidor" Text="{x:Bind ViewModel.ServerDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.BrowseServerDirectoryCommand}" Content="Procurar…" />
                            </Grid>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard ContentAlignment="Vertical" Header="Pasta de saves deste servidor" HorizontalContentAlignment="Stretch">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox AutomationProperties.Name="Pasta de saves" Text="{x:Bind ViewModel.SaveDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.BrowseSaveDirectoryCommand}" Content="Procurar…" />
                            </Grid>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <ItemsControl Margin="0,12,0,0" ItemsSource="{x:Bind ViewModel.Issues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:IssueItem">
                            <InfoBar Margin="0,0,0,4" IsClosable="False" IsOpen="True" Message="{x:Bind Message}" Severity="{x:Bind Severity}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Padding="36,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid MaxWidth="{StaticResource PageMaxWidth}" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                    <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.BusyText, Mode=OneWay}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{x:Bind ViewModel.CancelCommand}" Content="Cancelar" />
                <Button Grid.Column="2" Command="{x:Bind ViewModel.CreateCommand}" Content="Criar servidor" IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}" />
                <Button
                    Grid.Column="3"
                    MinWidth="140"
                    Command="{x:Bind ViewModel.CreateAndStartCommand}"
                    Content="Criar e iniciar"
                    IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Page>
