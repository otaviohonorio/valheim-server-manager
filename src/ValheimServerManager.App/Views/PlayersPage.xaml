<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ValheimServerManager.App.Views.PlayersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:ValheimServerManager.App.Helpers"
    xmlns:loc="using:ValheimServerManager.App.Localization"
    xmlns:vm="using:ValheimServerManager.App.ViewModels">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="12">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Bind loc:WorldStrings.Players_Title}" />
                <TextBlock Margin="0" Style="{StaticResource PageSubtitleStyle}" Text="{x:Bind ViewModel.OnlineText, Mode=OneWay}" />
            </StackPanel>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.NeedsRestart, Mode=OneWay}"
                Message="{x:Bind loc:WorldStrings.Players_RestartToApply}"
                Severity="Informational" />
            <InfoBar
                Title="{x:Bind loc:WorldStrings.Players_AllowListActiveTitle}"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.AllowListActive, Mode=OneWay}"
                Message="{x:Bind loc:WorldStrings.Players_AllowListActiveMessage}"
                Severity="Warning" />

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind loc:WorldStrings.Players_OnlineNowHeader}" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.HasOnline), Mode=OneWay}" />
            <Border Style="{StaticResource CardBorderStyle}" Padding="0" Visibility="{x:Bind helpers:Ui.Visible(ViewModel.HasOnline), Mode=OneWay}">
                <ItemsControl AutomationProperties.Name="{x:Bind loc:WorldStrings.Players_OnlineNowName}" ItemsSource="{x:Bind ViewModel.Online}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OnlinePlayerRow">
                            <Grid Padding="20,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <PersonPicture Width="36" Height="36" Initials="{x:Bind Initials}" />
                                    <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{ThemeResource SystemFillColorSuccessBrush}" Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}" StrokeThickness="2" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Detail}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind loc:WorldStrings.Players_EveryoneHeader}" />
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="20,12" ColumnSpacing="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind loc:WorldStrings.Players_ColumnPlayer}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind loc:WorldStrings.Players_ColumnAdmin}" ToolTipService.ToolTip="{x:Bind loc:WorldStrings.Players_ColumnAdminTooltip}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind loc:WorldStrings.Players_ColumnBanned}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind loc:WorldStrings.Players_ColumnPermitted}" />
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        Margin="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind loc:WorldStrings.Players_NoneRegistered}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind helpers:Ui.VisibleIfNone(ViewModel.Players.Count), Mode=OneWay}" />
                    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.Players}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlayerRowViewModel">
                                <Grid Padding="20,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <PersonPicture Width="36" Height="36" Initials="{x:Bind Initials}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind loc:WorldStrings.Players_OnlineBadge}"
                                                Visibility="{x:Bind helpers:Ui.Visible(IsOnline), Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Detail}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" MinWidth="0" AutomationProperties.Name="{x:Bind loc:WorldStrings.Players_Admin}" IsChecked="{x:Bind IsAdmin, Mode=TwoWay}" />
                                    <CheckBox Grid.Column="3" MinWidth="0" AutomationProperties.Name="{x:Bind loc:WorldStrings.Players_Banned}" IsChecked="{x:Bind IsBanned, Mode=TwoWay}" />
                                    <CheckBox Grid.Column="4" MinWidth="0" AutomationProperties.Name="{x:Bind loc:WorldStrings.Players_Permitted}" IsChecked="{x:Bind IsPermitted, Mode=TwoWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind loc:WorldStrings.Players_AddByIdHeader}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind loc:WorldStrings.Players_AddByIdHelp}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="{x:Bind loc:WorldStrings.Players_IdPlaceholder}" Text="{x:Bind ViewModel.NewId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.AddAdminCommand}" Content="{x:Bind loc:WorldStrings.Players_MakeAdmin}" />
                        <Button Grid.Column="2" Command="{x:Bind ViewModel.AddBannedCommand}" Content="{x:Bind loc:WorldStrings.Players_Ban}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.RefreshCommand}" Content="{x:Bind loc:WorldStrings.Players_RefreshList}" />
                        <Button Command="{x:Bind ViewModel.OpenListsFolderCommand}" Content="{x:Bind loc:WorldStrings.Players_OpenFilesFolder}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
